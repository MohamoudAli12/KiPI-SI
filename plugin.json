{
    "$schema": "https://go.kicad.org/api/schemas/v1",
    "identifier": "com.github.mohamoudali12.kipi_si",
    "name": "KiPI-SI",
    "description": "Power integrity: DC IR drop, current density, via currents and temperature in 3D, and AC PDN impedance over frequency",
    "runtime": {
        "type": "python",
        "min_version": "3.10"
    },
    "actions": [
        {
            "identifier": "kipi_si.open",
            "name": "KiPI-SI Power Integrity",
            "description": "Open the KiPI-SI power integrity analyzer",
            "show-button": true,
            "scopes": ["pcb"],
            "entrypoint": "kipi_si_entry.py",
            "icons-light": ["resources/kipi_si_24.png", "resources/kipi_si_48.png"],
            "icons-dark": ["resources/kipi_si_24.png", "resources/kipi_si_48.png"]
        }
    ]
}
